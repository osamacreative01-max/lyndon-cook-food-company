# ---------------------------------------------------------------------------
# The Lyndon Cook — environment variables
# Copy to `.env.local` for local development. Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Transactional email (server-side only, never exposed to the browser) ---
# SMTP relay used to deliver enquiry notifications.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# Optional: enable STARTTLS explicitly when the relay requires it.
# EMAIL_SERVER_SECURE=false

# Sender address. Use the company domain so the message passes SPF/DKIM.
ENQUIRY_FROM="The Lyndon Cook" <enquiries@tlcfc.co.uk>

# Destination inbox for website enquiries.
ENQUIRY_TO=info@tlcfc.co.uk

# --- Rate limiting ---------------------------------------------------------
# Number of enquiry POSTs accepted per IP per window. Counts every attempt,
# including ones that fail validation, so this is an abuse ceiling rather than
# a "successful enquiries" allowance. Keep it high enough that a shared office
# IP is not locked out.
RATE_LIMIT_MAX=10
# Rate limit window in seconds (900 = 15 minutes).
RATE_LIMIT_WINDOW=900

# --- Optional: capture a copy of enquiries in a CRM ------------------------
# If a CRM or webhook endpoint is used, set the URL and add it to the privacy
# page before going live.
# ENQUIRY_WEBHOOK_URL=
